$JOB           CARD DECK DEMONSTRATION
$EXECUTE       IBJOB
$IBJOB         GO,LOGIC,MAP,FIOCS
$IBFTC MAIN
C     DATA CARDS FOLLOW THE SOURCE DECK
      PROGRAM CARDS
      REAL X,Y,Z
      READ(5,90) X,Y
      Z=X**2+Y**2
      WRITE(6,100) X,Y,Z
   90 FORMAT(2F10.0)
  100 FORMAT(1H ,3F12.4)
      STOP
      END
$DATA
       3.0       4.0
$IBSYS
$STOP
